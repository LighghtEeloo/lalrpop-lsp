{
  "name": "lalrpop-language-server",
  "displayName": "LALRPOP Language Server",
  "description": "Language Server Protocol support for LALRPOP grammars",
  "license": "MIT",
  "version": "0.1.3",
  "keywords": [
    "LALRPOP",
    "language-server",
    "tower-lsp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/LighghtEeloo/lalrpop-lsp"
  },
  "publisher": "LitiaEeloo",
  "categories": [
    "Programming Languages"
  ],
  "engines": {
    "vscode": "^1.134.0"
  },
  "enabledApiProposals": [],
  "activationEvents": [
    "onLanguage:lalrpop"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "lalrpop",
        "aliases": [
          "LALRPOP",
          "lalrpop"
        ],
        "extensions": [
          "lalrpop"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lalrpop",
        "scopeName": "source.lalrpop",
        "path": "./syntaxes/lalrpop.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.starter": "rust"
        }
      }
    ],
    "configuration": {
      "type": "object",
      "title": "lalrpop-language-server",
      "properties": {
        "lalrpop-language-server.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "No traces",
            "Error only",
            "Full log"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the LALRPOP language server."
        },
        "lalrpop-language-server.server.path": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Path to the lalrpop-lsp executable. When empty, the extension searches PATH and can install the server with Cargo."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "compile": "pnpm run check && pnpm run bundle",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "vscode:prepublish": "pnpm run check && esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/which": "3.0.4",
    "@types/vscode": "1.134.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1",
    "which": "7.0.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
