{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "extensionHost",
      "request": "launch",
      "name": "Launch VS Code Client",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/editors/vscode"
      ],
      "outFiles": [
        "${workspaceFolder}/editors/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "build all",
      "env": {
        "SERVER_PATH": "${workspaceFolder}/target/debug/lalrpop-lsp"
      }
    }
  ]
}
