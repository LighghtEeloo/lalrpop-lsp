{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build language server",
      "type": "shell",
      "command": "cargo build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "build VS Code client",
      "type": "shell",
      "command": "pnpm run compile",
      "options": {
        "cwd": "${workspaceFolder}/editors/vscode"
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "build all",
      "dependsOrder": "parallel",
      "dependsOn": ["build language server", "build VS Code client"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
